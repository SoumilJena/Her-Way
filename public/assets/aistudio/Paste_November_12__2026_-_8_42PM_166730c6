    if (e.target.checked) {
      stealthCurtain.classList.remove('hidden');
      stealthCurtain.classList.add('flex');
    }
  });

  stealthCurtain.addEventListener('click', () => {
    tapCount++;
    clearTimeout(tapResetTimer);
    tapResetTimer = setTimeout(() => { tapCount = 0; }, 800);

    if (tapCount >= 3) {
      stealthCurtain.classList.add('hidden');
      stealthCurtain.classList.remove('flex');
