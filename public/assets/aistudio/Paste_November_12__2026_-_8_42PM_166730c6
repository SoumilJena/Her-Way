    if (holdTimer) {
      clearInterval(holdTimer);
      holdTimer = null;
    }
    const elapsed = Date.now() - startTime;
    if (elapsed < duration) {
      progressBar.style.strokeDashoffset = circumference;
      statusLabel.innerText = "False alarm prevention";
    }
  }

  trigger.addEventListener('mousedown', startHold);
  trigger.addEventListener('touchstart', startHold);
  window.addEventListener('mouseup', releaseHold);
  window.addEventListener('touchend', releaseHold);

